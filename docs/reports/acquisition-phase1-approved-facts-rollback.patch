+    .replace(/(<div\b[^>]*\bdata-detail-mobile-preview[^>]*>[\s\S]*?<img\b[^>]*\balt=)["'][^"']*["']/gi, `$1"${PENDING_MEDIA_TEXT}"`)
+    .replace(/(<div\b[^>]*\bdata-detail-mobile-preview[^>]*>[\s\S]*?<strong>)[\s\S]*?(<\/strong>)/gi, `$1${PENDING_MEDIA_TEXT}$2`);
