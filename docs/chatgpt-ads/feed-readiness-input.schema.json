{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HAODE Owner-verified feed readiness input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "products"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "OWNER_VERIFICATION_REQUIRED" },
    "products": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["sku", "brand", "price", "currency", "inventory_quantity", "availability", "inventory_checked_at", "image_approved", "platform_targets", "platform_registration_status", "approval_status", "approved_by", "approved_at", "evidence_refs"],
        "properties": {
          "sku": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,79}$" },
          "brand": { "type": "string", "minLength": 1, "maxLength": 80 },
          "price": { "type": "number", "exclusiveMinimum": 0 },
          "currency": { "const": "MXN" },
          "inventory_quantity": { "type": "integer", "minimum": 0 },
          "availability": { "enum": ["in_stock", "out_of_stock", "preorder", "backorder"] },
          "inventory_checked_at": { "type": "string", "format": "date-time" },
          "image_approved": { "const": true },
          "platform_targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["google_merchant", "meta_catalog", "chatgpt_ads"] } },
          "platform_registration_status": { "const": "verified" },
          "approval_status": { "const": "owner_verified" },
          "approved_by": { "type": "string", "minLength": 1, "maxLength": 80 },
          "approved_at": { "type": "string", "format": "date-time" },
          "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 240 } }
        }
      }
    }
  }
}
