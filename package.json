    "haode:check": "npm run test:customer-prices && npm run test:geo-seo && npm run test:seo-technical && npm run test:daily-ad-catalog && npm run test:catalog-gap-audit && npm run test:whatsapp-links && npm run haode:product-sync && npm run haode:quality-check"
