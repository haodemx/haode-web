    "test:catalog-gap-audit": "node --test tests/catalog-gap-audit.test.mjs",
    "test:whatsapp-links": "node --test tests/whatsapp-link-template.test.mjs",
    "audit:erp-catalog": "node scripts/audit-erp-catalog-gaps.mjs",
    "marketing:exposure-pack": "node scripts/generate-exposure-pack.mjs",
